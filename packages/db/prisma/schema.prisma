generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  name          String?
  city          String?
  role          Role           @default(CLIENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  password      String?
  bookings      Booking[]
  lawyerProfile LawyerProfile?
  leads         Lead[]
}

model LawyerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  name                String?
  email               String?
  phone               String?
  categories          String[]
  experience          Int       @default(0)
  rating              Float     @default(0.0)
  bio                 String?
  fees                Int       @default(0)
  verified            Boolean   @default(false)
  availability        Json?
  address             String?
  licenseNumber       String?
  state               String?
  languages           String[]
  onboardingCompleted Boolean   @default(false)
  isAvailable         Boolean   @default(true)
  degreeCert          String?
  enrollmentCert      String?
  panCard             String?
  photo               String?
  bookings            Booking[]
  user                User      @relation(fields: [userId], references: [id])
  leads               Lead[]    @relation("LawyerLeads")
}

model Lead {
  id            String         @id @default(uuid())
  userId        String?
  name          String
  phone         String
  category      String
  city          String
  description   String
  preferredTime String
  status               LeadStatus     @default(NEW)
  lawyerId             String?
  assignedAt           DateTime?
  acceptedAt           DateTime?
  declinedLawyerIds    String[]       @default([])
  slaStatus            String?
  lawyerResolution     String?        // "CLOSED", "CANCELLED", "FORWARDED"
  feedbackRating       Int?
  feedbackText         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  booking              Booking?
  lawyer               LawyerProfile? @relation("LawyerLeads", fields: [lawyerId], references: [id])
  user                 User?          @relation(fields: [userId], references: [id])
}

model Booking {
  id            String        @id @default(uuid())
  leadId        String        @unique
  clientId      String
  lawyerId      String
  status        BookingStatus @default(PENDING)
  paymentId     String?       @unique
  scheduledTime DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation(fields: [clientId], references: [id])
  lawyer        LawyerProfile @relation(fields: [lawyerId], references: [id])
  lead          Lead          @relation(fields: [leadId], references: [id])
  payment       Payment?      @relation(fields: [paymentId], references: [id])
}

model Payment {
  id                            String   @id @default(uuid())
  amount                        Int
  currency                      String   @default("INR")
  status                        String   @default("created")
  razorpayOrderId               String?  @unique
  razorpayPaymentId             String?  @unique
  razorpaySignature             String?
  phonePeMerchantTransactionId String?  @unique
  phonePeTransactionId         String?  @unique
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  booking                       Booking?
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  CLIENT
  LAWYER
  ADMIN
}

enum LeadStatus {
  NEW
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
